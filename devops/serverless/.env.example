# Store real values in shell/Cursor Runtime Secrets, never in this file.
# Used only by the local management client; never forwarded to workers.
RUNPOD_API_KEY=runpod_api_key_here

# Forwarded to endpoint workers as an environment variable, never job input.
GH_TOKEN=github_token_here

# Mandatory durability settings; forwarded only as endpoint environment.
B2_BUCKET=artifact_bucket_name
B2_ENDPOINT=https://s3.region.backblazeb2.com
B2_APPLICATION_KEY_ID=b2_key_id_here
B2_APPLICATION_KEY=b2_application_key_here

# Optional object-key prefix.
B2_PREFIX=runpod
