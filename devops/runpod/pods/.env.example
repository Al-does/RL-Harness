# Required. Store real values in shell/Cursor Runtime Secrets, never this file.
RUNPOD_API_KEY=runpod_api_key_here
GH_TOKEN=github_token_here

# Required for durable Community Cloud checkpoints and MLflow metadata.
B2_BUCKET=artifact_bucket_name
B2_ENDPOINT=https://s3.region.backblazeb2.com
B2_APPLICATION_KEY_ID=b2_key_id_here
B2_APPLICATION_KEY=b2_application_key_here

# Optional object-key prefix.
B2_PREFIX=runpod

# Optional local/private-key path for --interactive. The key is never uploaded;
# only its matching .pub content is injected into the Pod.
RUNPOD_SSH_KEY_PATH=~/.ssh/id_ed25519
